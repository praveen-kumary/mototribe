# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://root:password@localhost:5432/rideroom?schema=public"

# ─── Application URLs ────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_URL="http://localhost:4000"
PORT=4000

# ─── Authentication (REQUIRED — no fallbacks) ────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_PASSWORD=""  # Uncomment and set for production

# ─── Razorpay (optional — payment gateway) ───────────────
# When not set, the app runs in MOCK payment mode (auto-success).
# Set these to enable real Razorpay integration.
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# ─── Shiprocket (optional — shipping gateway) ────────────
# When not set, the app runs in MOCK shipping mode (instant tracking).
# Set these to enable real Shiprocket integration.
# SHIPROCKET_EMAIL=""
# SHIPROCKET_PASSWORD=""
# SHIPROCKET_API_URL="https://apiv2.shiprocket.in/v1/external"

# ─── Cloudinary (optional — image uploads) ────────────────
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
